# Generated at runtime
__pycache__/
*.py[cod]

# Scratch QML run with `qs -p`. Ignored so `./setup sync`, which copies what
# git would carry, never installs one.
_probe*.qml
_mock*.qml

# Editor and OS noise
*.swp
*.swo
*~
.DS_Store

# Per-machine overrides. The negation keeps home/.local/ from matching *.local.
*.local
!**/.local/
*.local.conf

# Secrets — never commit
.env
.env.*
*.key
*.pem
*.gpg
id_rsa
id_ed25519
home/.local/state/notch/theme.lock
home/.config/quickshell/scripts/ask.py.bak*

# The vendored mov-cli runs from a venv, not from the repository.
home/.local/share/notch/mov-cli/.venv/

# Build leftovers from the vendored plugin.
home/.local/share/notch/mov-cli/plugins/build/
home/.local/share/notch/mov-cli/plugins/*.egg-info/
