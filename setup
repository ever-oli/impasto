#!/bin/bash
# ╭──────────────────────────────────────────────────────────────────────────╮
# │   notch · setup                                       │
# │   github.com/ever-oli/notch  (branch main)                        │
# ╰──────────────────────────────────────────────────────────────────────────╯
#
#   ./setup                 packages, then files, then the theme
#   ./setup packages        pacman -S --needed every pacman row of home/.local/share/notch/deps.tsv
#   ./setup fonts           AnnotationMono and Tinos Nerd Fonts into ~/.local/share/fonts
#   ./setup files           copy home/ into ~, backing up what it replaces
#   ./setup theme [name]    notch-theme set (default e-ink)
#   ./setup uninstall       remove what `files` installed (backups are kept)
#
# Home directory only, plus packages. It never touches the boot loader, the
# initramfs, a display manager, PAM or anything else under /etc.
set -euo pipefail

REPO=$(cd "$(dirname "$0")" && pwd)
STAMP=$(date +%Y%m%d-%H%M%S)
BACKUP="$HOME/.config-backups/notch-$STAMP"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/notch"
MANIFEST="$STATE/files"

say() { printf '\033[1m::\033[0m %s\n' "$*"; }

packages() {
    mapfile -t want < <(awk -F'\t' '!/^#/ && NF && $2=="pacman" {print $1}' "$REPO/home/.local/share/notch/deps.tsv")
    mapfile -t missing < <(for p in "${want[@]}"; do pacman -Qq "$p" >/dev/null 2>&1 || echo "$p"; done)
    if ((${#missing[@]} == 0)); then say "packages: all present"; return; fi
    say "packages: installing ${missing[*]}"
    sudo pacman -S --needed --noconfirm "${missing[@]}"
}

# Nerd Fonts from the latest ryanoasis/nerd-fonts release: AnnotationMono is
# the font everywhere, Tinos is the bar's.
NERD_FONTS=(AnnotationMono Tinos)
fonts() {
    local dir="${XDG_DATA_HOME:-$HOME/.local/share}/fonts/nerd" tmp
    tmp=$(mktemp -d)
    for f in "${NERD_FONTS[@]}"; do
        if [ -d "$dir/$f" ]; then say "fonts: $f present"; continue; fi
        curl -fsSL -o "$tmp/$f.zip" "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/$f.zip"
        mkdir -p "$dir/$f"
        python3 -m zipfile -e "$tmp/$f.zip" "$dir/$f"
        say "fonts: $f installed"
    done
    rm -rf "$tmp"
    # Mermaid renders in chrome-headless-shell: Helium navigates on start and breaks mmdc.
    local chrome="$HOME/.cache/notch/chrome"
    if ls "$chrome"/chrome-headless-shell/*/*/chrome-headless-shell >/dev/null 2>&1; then say "fonts: headless shell present"
    else npx -y @puppeteer/browsers install chrome-headless-shell@stable --path "$chrome" >/dev/null && say "fonts: chrome-headless-shell installed (mermaid)"; fi
    fc-cache -f "$dir" >/dev/null
}

files() {
    mkdir -p "$STATE"
    # The shell's directory is replaced whole, so files cut from the fork do
    # not linger from an older install.
    if [ -d "$HOME/.config/quickshell" ]; then
        mkdir -p "$BACKUP/.config"
        cp -a "$HOME/.config/quickshell" "$BACKUP/.config/"
        rm -rf "$HOME/.config/quickshell"
    fi
    : > "$MANIFEST"
    # Each package says where its files go; the rules live beside it, so a
    # package can be read on its own.
    for manifest in "$REPO"/packages/*/install; do
        dir=$(dirname "$manifest")
        while read -r src dst; do
            [ -z "${src:-}" ] && continue
            case "$src" in \#*) continue ;; esac
            [ -e "$dir/$src" ] || continue
            dest="$HOME/$dst"
            # A directory lands as the destination itself, not inside it:
            # another package may have made the directory already.
            if [ -d "$dir/$src" ]; then
                if [ -e "$dest" ] && ! diff -rq "$dir/$src" "$dest" >/dev/null 2>&1; then
                    mkdir -p "$BACKUP/$(dirname "$dst")"
                    cp -a "$dest" "$BACKUP/$dst"
                fi
                mkdir -p "$dest"
                cp -a "$dir/$src/." "$dest/"
            else
                if [ -e "$dest" ] && ! cmp -s "$dir/$src" "$dest"; then
                    mkdir -p "$BACKUP/$(dirname "$dst")"
                    cp -a "$dest" "$BACKUP/$dst"
                fi
                mkdir -p "$(dirname "$dest")"
                cp -a "$dir/$src" "$dest"
            fi
            echo "$dst" >> "$MANIFEST"
        done < "$manifest"
    done
    chmod +x "$HOME"/.local/bin/notch* "$HOME"/.config/quickshell/scripts/*.py
    [ -d "$BACKUP" ] && say "files: replaced files backed up to $BACKUP"
    say "files: $(wc -l < "$MANIFEST") installed"
}

theme() {
    "$HOME/.local/bin/notch-theme" set "${1:-$("$HOME/.local/bin/notch-theme" current)}"
}

uninstall() {
    [ -f "$MANIFEST" ] || { say "nothing recorded in $MANIFEST"; return; }
    while read -r rel; do rm -f "$HOME/$rel"; done < "$MANIFEST"
    rm -rf "$HOME/.config/quickshell"
    rm -f "$MANIFEST"
    say "removed; backups under ~/.config-backups are untouched"
}

case ${1:-all} in
    all)       packages; fonts; files; theme "${2:-}"
               say "start the shell: niri msg action spawn -- qs -n  (the niri config spawns it at login)" ;;
    packages)  packages ;;
    fonts)     fonts ;;
    files)     files ;;
    theme)     theme "${2:-}" ;;
    uninstall) uninstall ;;
    *)         sed -n '7,14p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
