#!/bin/bash
# notch doctor — is everything the palette leans on in place?
bad=0
ok()   { printf '  \e[32m✓\e[0m %s\n' "$1"; }
no()   { printf '  \e[31m✗\e[0m %s\n' "$1"; bad=$((bad+1)); }
warn() { printf '  \e[33m!\e[0m %s\n' "$1"; }
export PATH="$HOME/.local/bin:$HOME/.opencode/bin:$HOME/.bun/bin:$HOME/.local/share/mise/shims:$PATH"
cfg=${XDG_CONFIG_HOME:-$HOME/.config}
echo "Hotkeys (niri)"
kdl=$cfg/niri/config.kdl
if [ -f "$kdl" ]; then
    for want in "launcher:palette" "ask:assistant" "picker.{0,4}theme:theme picker" "windows:window switcher" "files:file search"; do
        pat=${want%%:*}; label=${want#*:}
        grep -Eq "notch.*($pat)" "$kdl" && ok "$label bound" || no "$label not bound in $kdl"
    done
    command -v niri >/dev/null && { niri validate -c "$kdl" >/dev/null 2>&1 && ok "niri config valid" || no "niri validate fails"; }
else no "no $kdl"; fi
echo "Shell"
pgrep -u "$(id -u)" -x qs >/dev/null || pgrep -u "$(id -u)" -x quickshell >/dev/null && ok "quickshell running" || no "quickshell not running"
qs ipc call palette rows >/dev/null 2>&1 && ok "palette IPC answers" || warn "palette IPC did not answer (no session env?)"
echo "Orb"
[ -f "$cfg/quickshell/orb/Orb.qml" ] && ok "orb installed" || no "orb missing from $cfg/quickshell/orb"
grep -q '"orb" "toggle"' "$kdl" 2>/dev/null && ok "orb bound ($(grep '"orb" "toggle"' "$kdl" | awk '{print $1}' | head -1))" || no "orb not bound in $kdl"
qs ipc call orb status 2>/dev/null | grep -q '"opened"' && ok "orb IPC answers" || warn "orb IPC did not answer (no session env?)"
echo "Text size"
fsz=$(cat "$cfg/notch/font-size" 2>/dev/null || echo 11)
case $fsz in ''|*[!0-9]*) no "font-size is not a number: $fsz";; *) [ "$fsz" -ge 6 ] && [ "$fsz" -le 32 ] && ok "text size $fsz" || no "text size $fsz out of 6-32";; esac
st=${XDG_STATE_HOME:-$HOME/.local/state}/notch/theme.json
grep -q "\"fontSize\": $fsz" "$st" 2>/dev/null && ok "shell follows it" || no "theme.json not at size $fsz (run: notch-theme restore)"
grep -q "font-size = $((fsz+2))" "$cfg/ghostty/notch-theme" 2>/dev/null && ok "ghostty follows it" || no "ghostty not at $((fsz+2))"
grep -q "size=$((fsz+1))" "$cfg/fuzzel/fuzzel.ini" 2>/dev/null && ok "fuzzel follows it" || no "fuzzel not at $((fsz+1))"
gsettings get org.gnome.desktop.interface font-name 2>/dev/null | grep -q " $fsz'" && ok "GTK follows it" || warn "GTK font not at $fsz"
echo "Dependencies"
for d in qs niri qalc fd opencode wl-copy grim slurp tesseract helium-browser gtk-launch fuzzel ghostty helix notify-send python3; do
    command -v "$d" >/dev/null && ok "$d" || no "$d missing"
done
echo
[ $bad -eq 0 ] && echo "All good." || { echo "$bad problem(s)."; exit 1; }
