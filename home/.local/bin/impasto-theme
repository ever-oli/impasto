#!/usr/bin/env python3
"""impasto-theme — the four ink themes, applied everywhere at once.

  impasto-theme list
  impasto-theme set <name> [wallpaper]   e-ink · e-ink-dark · red-ink · red-ink-dark
  impasto-theme current
  impasto-theme next                     cycle the four themes
  impasto-theme next-wallpaper

colors.toml is the single source of truth. Templates in
~/.local/share/impasto/themed/*.tpl (Omarchy's {{ key }} syntax, see
basecamp/omarchy, MIT) are rendered to each app, then every app is told to
reload in parallel; one app failing never stops the rest. A lock keeps two
switches from interleaving.

Reads ~/.local/share/impasto/themes/<name>/colors.toml; the shell (bar and
notifications) watches ~/.local/state/impasto/theme.json. Templates go to
ghostty (USR2), helix theme "impasto" (USR1), niri include, fuzzel, btop (USR2), fastfetch,
fzf (sourced by .bashrc), gtk 3/4 css, qt6ct (if installed) and T3 Code;
gsettings handles libadwaita light/dark and icons; Helium gets a Chromium
color policy through the impasto-browser-color helper.
The wallpaper runs under swaybg as a user service so it survives this script.
"""
import fcntl, json, os, re, shutil, subprocess, sys, tomllib
from concurrent.futures import ThreadPoolExecutor

HOME = os.path.expanduser("~")
CFG = os.environ.get("XDG_CONFIG_HOME", f"{HOME}/.config")
STATE = os.environ.get("XDG_STATE_HOME", f"{HOME}/.local/state") + "/impasto"
THEMES = f"{HOME}/.local/share/impasto/themes"
DEFAULT = "e-ink"


def names():
    return sorted(d for d in os.listdir(THEMES) if os.path.isfile(f"{THEMES}/{d}/colors.toml"))


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def ensure_line(path, line, pattern=None, top=False):
    """Make sure a config file carries `line` (replacing a matching one)."""
    text = open(path).read() if os.path.exists(path) else ""
    if pattern and re.search(pattern, text, re.M):
        text = re.sub(pattern, line, text, count=1, flags=re.M)
    elif line not in text:
        text = (line + "\n" + text) if top else (text.rstrip("\n") + "\n" + line + "\n").lstrip("\n")
    write(path, text)


def h(c):  # "#RRGGBB" -> "RRGGBB"
    return c.lstrip("#")


def mix(a, b, t):
    """a blended towards b by t, as #rrggbb."""
    a, b = (tuple(int(x.lstrip("#")[i:i + 2], 16) for i in (0, 2, 4)) for x in (a, b))
    return "#%02x%02x%02x" % tuple(round(p + (q - p) * t) for p, q in zip(a, b))


def shell(c, name):
    """The island is ink: on a light theme the darkest ink with paper text,
    on a dark one the darkest paper with the theme's own text."""
    dark = c.get("mode") == "dark"
    ink = c["darker_background"] if dark else c["bright_foreground"]
    text = c["foreground"] if dark else c["background"]
    return {
        "island": ink,
        "islandSurface": mix(ink, text, 0.07),
        "islandSurfaceHover": mix(ink, text, 0.12),
        "islandBorder": mix(ink, text, 0.16),
        "background": ink, "surface": mix(ink, text, 0.07),
        "surfaceHover": mix(ink, text, 0.12), "border": mix(ink, text, 0.18),
        "text": text, "textMuted": mix(text, ink, 0.4),
        "accent": c["accent"] if dark else mix(c["accent"], c["background"], 0.25),
        "accentHover": mix(c["accent"], text, 0.3),
        "accentText": ink,
        "red": c["red"], "green": c["green"], "yellow": c["yellow"], "blue": c["blue"],
    }


TEMPLATES = f"{HOME}/.local/share/impasto/themed"
TOKEN = re.compile(r"\{\{\s*(mix(?:_strip)?\s+(\w+)\s+(\w+)\s+([\d.]+)%?|(\w+?)(_strip|_rgb|_ansi)?)\s*\}\}")


def render(text, c):
    """Omarchy's template tokens: {{ key }}, {{ key_strip }}, {{ key_rgb }},
    {{ key_ansi }} (38;2;r;g;b) and {{ mix a b N% }}."""
    def one(m):
        if m.group(2):
            value = mix(c[m.group(2)], c[m.group(3)], float(m.group(4)) / 100)
            return h(value) if "_strip" in m.group(1) else value
        key, kind = m.group(5), m.group(6)
        value = str(c.get(key, m.group(0)))
        if not value.startswith("#"):
            return value
        rgb = [int(value[i:i + 2], 16) for i in (1, 3, 5)]
        return {"_strip": h(value), "_rgb": ",".join(map(str, rgb)),
                "_ansi": "38;2;" + ";".join(map(str, rgb))}.get(kind, value)
    return TOKEN.sub(one, text)


# template -> where it lands. A missing app just gets a file it never reads.
TARGETS = {
    "ghostty.conf.tpl": f"{CFG}/ghostty/impasto-theme",
    "helix.toml.tpl": f"{CFG}/helix/themes/impasto.toml",
    "niri.kdl.tpl": f"{CFG}/niri/impasto-theme.kdl",
    "fuzzel.ini.tpl": f"{CFG}/fuzzel/fuzzel.ini",
    "btop.theme.tpl": f"{CFG}/btop/themes/impasto.theme",
    "fastfetch.jsonc.tpl": f"{CFG}/fastfetch/config.jsonc",
    "fzf.sh.tpl": f"{STATE}/fzf.sh",
    "gtk.css.tpl": [f"{CFG}/gtk-3.0/gtk.css", f"{CFG}/gtk-4.0/gtk.css"],
    "qt6ct.conf.tpl": f"{CFG}/qt6ct/colors/impasto.conf",
    "t3code.json.tpl": f"{HOME}/.t3/userdata/themes/impasto.json",
}


def run(*cmd):
    return subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15).returncode


def hooks(c, name):
    """Each tells one app; run in parallel, failures reported, never fatal."""
    dark = c.get("mode") == "dark"
    def ghostty():
        ensure_line(f"{CFG}/ghostty/config", "config-file = ?impasto-theme", top=False)
        run("pkill", "-USR2", "-x", "ghostty")
    def helix():
        ensure_line(f"{CFG}/helix/config.toml", 'theme = "impasto"', r'^theme\s*=.*$', top=True)
        run("pkill", "-USR1", "-x", "helix"); run("pkill", "-USR1", "-x", "hx")
    def niri():
        run("niri", "msg", "action", "load-config-file")
    def btop():
        conf = f"{CFG}/btop/btop.conf"
        if os.path.exists(conf):
            ensure_line(conf, 'color_theme = "impasto"', r'^color_theme\s*=.*$')
        else:
            write(conf, 'color_theme = "impasto"\ntheme_background = True\n')
        run("pkill", "-USR2", "-x", "btop")
    def fzf():
        ensure_line(f"{HOME}/.bashrc", '[ -f ~/.local/state/impasto/fzf.sh ] && . ~/.local/state/impasto/fzf.sh')
    def gtk():
        scheme = "prefer-dark" if dark else "prefer-light"
        run("gsettings", "set", "org.gnome.desktop.interface", "color-scheme", scheme)
        run("gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", "Adwaita-dark" if dark else "Adwaita")
    def icons():
        run("gsettings", "set", "org.gnome.desktop.interface", "icon-theme", "Papirus-Dark" if dark else "Papirus-Light")
    def qt():
        if shutil.which("qt6ct"):
            ensure_line(f"{CFG}/qt6ct/qt6ct.conf", f"color_scheme_path={CFG}/qt6ct/colors/impasto.conf", r"^color_scheme_path=.*$")
    def browser():
        # A root-owned Chromium policy (Helium reads /etc/chromium); the one
        # privileged step is a fixed helper allowed in sudoers, hex only.
        helper = "/usr/local/bin/impasto-browser-color"
        if os.access(helper, os.X_OK):
            run("sudo", "-n", helper, c["background"], "dark" if dark else "light")
            if subprocess.run(["pgrep", "-x", "helium"], stdout=subprocess.DEVNULL).returncode == 0:
                subprocess.Popen(["helium-browser", "--refresh-platform-policy", "--no-startup-window"],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return {"ghostty": ghostty, "helix": helix, "niri": niri, "btop": btop, "fzf": fzf,
            "gtk": gtk, "icons": icons, "qt": qt, "browser": browser}


def wallpapers(name):
    folder = f"{THEMES}/{name}/backgrounds"
    if not os.path.isdir(folder):
        return []
    return sorted(f"{folder}/{f}" for f in os.listdir(folder)
                  if f.lower().endswith((".jpg", ".jpeg", ".png", ".webp")))


def set_wallpaper(path, colour):
    """swaybg as a transient user unit: owned by systemd, not this shell."""
    subprocess.run(["systemctl", "--user", "stop", "impasto-wallpaper"],
                   stderr=subprocess.DEVNULL)
    subprocess.run(["systemctl", "--user", "reset-failed", "impasto-wallpaper"],
                   stderr=subprocess.DEVNULL)
    args = ["swaybg", "-m", "fill", "-c", colour] + (["-i", path] if path else [])
    subprocess.run(["systemd-run", "--user", "--quiet", "--collect",
                    "--unit", "impasto-wallpaper", "-p", "Restart=on-failure", *args])


def current():
    try:
        return json.load(open(f"{STATE}/theme.json"))
    except Exception:
        return {}


def apply(name, wallpaper=None):
    if name not in names():
        sys.exit(f"no theme {name!r} (have: {', '.join(names())})")
    with open(f"{THEMES}/{name}/colors.toml", "rb") as f:
        c = tomllib.load(f)
    walls = wallpapers(name)
    if wallpaper is None:
        before = current()
        keep = os.path.basename(before.get("wallpaper", ""))
        wallpaper = next((w for w in walls if os.path.basename(w) == keep), None) \
            or next((w for w in walls if w.endswith("wrinkled-paper.jpg")), walls[0] if walls else "")
    title = name.replace("-", " ").title()
    write(f"{STATE}/theme.json", json.dumps({"id": name, "name": title, "mode": c.get("mode", "light"),
                                              "wallpaper": wallpaper, "shell": shell(c, name)}, indent=1))

    for tpl, dest in TARGETS.items():
        try:
            text = render(open(f"{TEMPLATES}/{tpl}").read(), c)
            for path in dest if isinstance(dest, list) else [dest]:
                if tpl == "t3code.json.tpl" and not os.path.isdir(f"{HOME}/.t3/userdata"):
                    continue
                write(path, text)
        except Exception as error:
            print(f"  {tpl}: {error}", file=sys.stderr)

    failed = []
    with ThreadPoolExecutor(max_workers=8) as pool:
        for app, job in [(app, pool.submit(fn)) for app, fn in hooks(c, name).items()]:
            try:
                job.result(timeout=20)
            except Exception as error:
                failed.append(f"{app}: {error}")
    for line in failed:
        print(f"  {line}", file=sys.stderr)
    set_wallpaper(wallpaper, c["background"])
    print(f"{name} · {os.path.basename(wallpaper) if wallpaper else 'no wallpaper'}")


def main():
    # One switch at a time; a second waits for the first to finish.
    os.makedirs(STATE, exist_ok=True)
    lock = open(f"{STATE}/theme.lock", "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    verb = sys.argv[1] if len(sys.argv) > 1 else "current"
    if verb == "list":
        print("\n".join(names()))
    elif verb == "set":
        apply(sys.argv[2] if len(sys.argv) > 2 else DEFAULT, sys.argv[3] if len(sys.argv) > 3 else None)
    elif verb == "next":
        have = names()
        now = current().get("id", DEFAULT)
        apply(have[(have.index(now) + 1) % len(have)] if now in have else DEFAULT)
    elif verb == "next-wallpaper":
        now = current()
        walls = wallpapers(now.get("id", DEFAULT))
        at = walls.index(now["wallpaper"]) if now.get("wallpaper") in walls else -1
        apply(now.get("id", DEFAULT), walls[(at + 1) % len(walls)] if walls else "")
    elif verb == "restore":
        apply(current().get("id", DEFAULT), current().get("wallpaper") or None)
    elif verb == "current":
        print(current().get("id", DEFAULT))
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
