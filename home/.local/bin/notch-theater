#!/bin/bash
# notch-theater — ASCII Theater (ssh watch.ascii.theater, mschf) dropped down
# under the notch, like notch-term. A throwaway tmux socket draws the chrome:
# accent marquee on top, framed 80x23 screen; colours from the Notch theme.
#   notch-theater toggle   open it, focus it, or close it when it is focused
# q in the stream quits; closing only kills the "notch-theater" tmux socket.
# Placement is a niri window rule on app-id com.notch.theater (config.kdl).
set -u
ID=com.notch.theater
SOCK=${NOTCH_THEATER_SOCK:-notch-theater}
# Layout, in cells: the stream is a fixed 80x23 canvas. Velvet panes of 1 cell
# sit around it so tmux draws a heavy frame hugging exactly 80x23:
#   1 velvet + 1 frame + 80 + 1 frame + 1 velvet = 84 cols
#   1 velvet + 1 frame + 23 + 1 frame + 1 velvet = 27 rows, + 1 marquee = 28
# Ghostty sizes itself in cells (window-width/height); Ghostty padding is the
# outer velvet. At 14pt AnnotationM (500/800 em advance, 1000/800 em line, 96
# dpi) a cell is ~12x24 px, so 84x28 cells + 2x(48,24) pad ~ 1104x720 px.
SW=80 SH=23 W=84 H=27 PT=14 PADX=48 PADY=24
stage() { # $1 conf, $2 stream command: detached session, frame panes, size pinned
    local t=theater
    tmux -L $SOCK -f "$1" new-session -d -s $t -x $W -y $H "$2; tmux -L $SOCK kill-server"
    tmux -L $SOCK resize-window -t $t -x $W -y $H
    local s; s=$(tmux -L $SOCK display -p -t $t '#{pane_id}')
    tmux -L $SOCK split-window -t "$s" -vb -l 1 'exec sleep infinity' \; \
         split-window -t "$s" -v -l 1 'exec sleep infinity' \; \
         split-window -t "$s" -hb -l 1 'exec sleep infinity' \; \
         split-window -t "$s" -h -l 1 'exec sleep infinity' \; \
         select-pane -t "$s"
}
win() { niri msg -j windows 2>/dev/null | python3 -c "import json,sys
for w in json.load(sys.stdin):
    if w.get('app_id')=='$ID': print(w['id'], int(w.get('is_focused',False))); break"; }
colors() { python3 - <<'PY'
import json, os, tomllib
h = os.path.expanduser("~")
c = {}
try:
    tid = json.load(open(f"{h}/.local/state/notch/theme.json"))["id"]
    c = tomllib.load(open(f"{h}/.local/share/notch/themes/{tid}/colors.toml", "rb"))
except Exception: pass
bg, fg = c.get("background", "#000000"), c.get("foreground", "#c7f0c7")
acc = c.get("accent", "#8a2312"); border = c.get("selection_background", c.get("color8", acc))
lum = lambda x: sum(w * int(x[i:i+2], 16) / 255 for w, i in ((.2126, 1), (.7152, 3), (.0722, 5)))
text = bg if abs(lum(acc) - lum(bg)) >= abs(lum(acc) - lum(fg)) else fg
print(bg, fg, acc, border, text)
PY
}
case ${1:-toggle} in
    toggle)
        read -r wid focused < <(win) || true
        if [ -n "${wid:-}" ]; then
            if [ "$focused" = 1 ]; then niri msg action close-window --id "$wid"; tmux -L $SOCK kill-server 2>/dev/null
            else niri msg action focus-window --id "$wid"; fi
            exit 0
        fi
        tmux -L $SOCK kill-server 2>/dev/null   # a stale server would ignore the fresh conf
        read -r BG FG ACC BORDER TEXT < <(colors)
        conf=${XDG_CACHE_HOME:-$HOME/.cache}/notch/theater.tmux.conf
        mkdir -p "${conf%/*}"
        cat > "$conf" <<CONF
set -g status-position top
set -g status-interval 30
set -g status-style "bg=$ACC,fg=$TEXT"
set -g status-left-length 60
set -g status-left "#[bold] ✦ ASCII THEATER#[nobold] │ NOW SHOWING "
set -g status-right " q quit │ #[bold]%H:%M "
set -g window-status-format ""
set -g window-status-current-format ""
set -g pane-border-lines heavy
set -g pane-border-style "fg=$BORDER"
set -g pane-active-border-style "fg=$ACC"
set -g default-terminal tmux-256color
set -g escape-time 0
set -g bell-action none
set -g set-titles off
set -g window-size manual
set -g default-size ${W}x${H}
set -g mouse off
CONF
        stage "$conf" "${NOTCH_THEATER_STREAM:-ssh -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR watch.ascii.theater}"
        [ -n "${NOTCH_THEATER_DRY:-}" ] && exit 0   # tests: tmux only, no window
        exec setsid -f ghostty --class=$ID --gtk-single-instance=false --title="ASCII Theater" \
            --window-decoration=none --font-size=$PT --background="$BG" --foreground="$FG" \
            --window-width=$W --window-height=$((H + 1)) \
            --window-padding-x=$PADX --window-padding-y=$PADY --window-padding-balance=true \
            -e tmux -L $SOCK attach -t theater >/dev/null 2>&1 ;;
    *) sed -n '2,7p' "$0" ;;
esac
