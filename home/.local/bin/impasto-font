#!/bin/sh
# impasto-font <family> — the terminal's typeface, as a ghostty include.
[ -n "$1" ] || { echo "usage: impasto-font <family>"; exit 1; }
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty"
mkdir -p "$cfg"
printf 'font-family = "%s"\n' "$1" > "$cfg/impasto-font"
grep -qx 'config-file = ?impasto-font' "$cfg/config" 2>/dev/null || echo 'config-file = ?impasto-font' >> "$cfg/config"
pkill -USR2 -x ghostty
notify-send "Terminal font" "$1"
