#!/usr/bin/env python3
"""notch-watch — play a title in the island terminal, where the video shows.

The picture goes in the terminal: mpv's truecolor output draws it where
the text is, so no window opens and no GPU is needed. Anime is resolved
through hianime (the same source ani-cli uses); a film or a series brings
its own address, resolved on the instabox box, whose address those
sources accept.

  notch-watch anime "<title>" [--episode N]   resolve and play
  notch-watch film <movie|tv> <id> "<title>" <year> [--season N] [--episode N]
  notch-watch url <url> [--referer <url>]     play what you have
"""

import json
import os
import subprocess
import sys
import tempfile
import time

HOME = os.environ.get("HOME", os.path.expanduser("~"))
SCRIPT = os.path.join(HOME, ".config/quickshell/scripts/stream.py")
SESSION = "notch"


def terminal_open():
    try:
        out = subprocess.run(["notch-term", "status"], capture_output=True,
                             timeout=10).stdout
        return bool(json.loads(out or "{}").get("open"))
    except Exception:
        return False


def in_terminal(command):
    """Run a command in the island terminal, opening it if it is closed."""
    if not terminal_open():
        subprocess.run(["notch-term", "toggle"], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL)
        time.sleep(2.0)
    subprocess.run(["tmux", "send-keys", "-t", SESSION, command, "Enter"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def say(message):
    """Leave a note in the island terminal, so a failure is not a silence."""
    in_terminal("echo '" + str(message).replace("'", "'\\''") + "'")


def subtitle_file(url, referer):
    """The subtitle, fetched here.

    The host that carries the subtitles wants the player's referer, and
    mpv does not send one for a subtitle file, so the notch fetches it
    and hands mpv a path it can open.
    """
    if not url:
        return ""
    path = os.path.join(tempfile.gettempdir(), f"notch-sub-{os.getpid()}.vtt")
    try:
        subprocess.run(["curl", "-sS", "-o", path, "--max-time", "30",
                        "-H", f"Referer: {referer or ''}", url],
                       capture_output=True, timeout=45)
    except Exception:
        return ""
    try:
        if os.path.getsize(path) > 100:
            return path
    except OSError:
        pass
    return ""


def resolve(title, episode):
    out = subprocess.run([sys.executable, SCRIPT, "resolve", title,
                          "--episode", str(episode)],
                         capture_output=True, text=True, timeout=180)
    if out.returncode != 0:
        raise RuntimeError(out.stderr.strip()[-300:] or "could not resolve that title")
    return json.loads(out.stdout)


def resolve_film(media_kind, media_id, title, year, season, episode):
    """The stream for a film or a series.

    The pages that carry films and series answer a cloud address with a
    refusal, so the notch does what the player does: it asks the api the
    player asks and opens the answer the way the player opens it. No
    browser, no box.
    """
    command = [node(), os.path.expanduser("~/.local/bin/notch-resolve.mjs"),
               "--tmdb", str(media_id), "--type", media_kind,
               "--title", title or "", "--year", str(year or ""), "--json"]
    if season:
        command += ["--season", str(season)]
    if episode:
        command += ["--episode", str(episode)]
    out = subprocess.run(command, capture_output=True, text=True, timeout=180)
    if out.returncode != 0:
        raise RuntimeError(out.stderr.strip()[-300:] or "no stream for that title")
    found = json.loads(out.stdout)
    return {"url": found["found"], "referer": found.get("referer", "")}


def node():
    """Node, wherever it lives on this machine."""
    import shutil
    found = shutil.which("node")
    if found:
        return found
    home = os.environ.get("HOME", os.path.expanduser("~"))
    for path in (f"{home}/.local/share/mise/installs/node/latest/bin/node",
                 f"{home}/.local/bin/node", "/usr/bin/node"):
        if os.path.exists(path):
            return path
    raise RuntimeError("node is not on this machine")


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__)
        sys.exit(0)
    kind = args[0]
    media_kind = ""
    media_id = ""
    title = ""
    season = ""
    episode = 1
    if "--episode" in args:
        episode = int(args[args.index("--episode") + 1])
    referer = None
    subtitle = ""
    if "--referer" in args:
        referer = args[args.index("--referer") + 1]

    if kind == "anime":
        title = " ".join(a for a in args[1:]
                         if not a.isdigit() and a != "--episode")
        try:
            found = resolve(title, episode)
        except Exception as error:
            say(f"notch-watch: {error}")
            raise
        url, referer = found["url"], found.get("referer")
        subtitle = found.get("subtitle", "")
        title = found.get("title", title)
    elif kind == "film":
        media_kind = args[1]                       # movie or tv
        media_id = args[2]
        title = args[3] if len(args) > 3 else ""
        year = args[4] if len(args) > 4 else ""
        if "--season" in args:
            season = args[args.index("--season") + 1]
        try:
            found = resolve_film(media_kind, media_id, title, year, season, episode)
        except Exception as error:
            say(f"notch-watch: {error}")
            raise
        url, referer = found["url"], found["referer"]
        subtitle = found.get("subtitle", "")
        title = found.get("title", title)
    elif kind == "url":
        url = args[1]
    else:
        print(__doc__)
        sys.exit(0)

    command = f"notch-video '{url}'"
    if referer:
        command += f" --referer '{referer}'"
    if title:
        command += f" --title '{title}'"
    if subtitle:
        local = subtitle_file(subtitle, referer)
        if local:
            command += f" --sub '{local}'"
    if media_kind:
        command += f" --kind {media_kind}"
    if media_id:
        command += f" --media-id {media_id}"
    if season:
        command += f" --season {season}"
    if episode:
        command += f" --episode {episode}"
    in_terminal(command)
    print(json.dumps({"url": url, "referer": referer, "subtitle": subtitle,
                      "episode": episode}))


if __name__ == "__main__":
    main()
