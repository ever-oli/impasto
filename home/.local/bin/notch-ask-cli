#!/usr/bin/env python3
"""notch-ask-cli — one question to the notch's engine, printed here.
  notch-ask-cli [--backend pi|opencode] [--mode <id>] "<question>"
Approvals are asked on the terminal: y = once, a = rest of this run, n = deny.
With no terminal every gated action is denied."""
import json, os, subprocess, sys
args, opts = sys.argv[1:], {}
while args and args[0] in ("--backend", "--mode"):
    opts[args[0][2:]] = args[1]; args = args[2:]
if not args:
    sys.exit(__doc__)
cmd = [sys.executable, os.path.expanduser("~/.config/quickshell/scripts/ask.py"), "--once"]
if "backend" in opts:
    cmd[2:2] = ["--backend", opts["backend"]]
p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, bufsize=1)
def send(m): p.stdin.write(json.dumps(m) + "\n"); p.stdin.flush()
send({"op": "ask", "text": " ".join(args), "mode": opts.get("mode", "general")})
try:
    tty = open("/dev/tty", "r+")
except OSError:
    tty = None
code = 0
for line in p.stdout:
    e = json.loads(line)
    t = e["type"]
    if t == "chunk": print(e["text"], end="", flush=True)
    elif t == "tool": print(f"\n  · {e['title']} {e['status']}", file=sys.stderr)
    elif t == "permission":
        ans = "n"
        if tty:
            tty.write(f"\n⚠ {e['title']}: {e['detail']}\n  allow? [y]es / [a]ll this run / [N]o: "); tty.flush()
            ans = (tty.readline().strip() or "n")[0].lower()
        send({"op": "answer", "id": e["id"], "allow": ans in "ya", "session": ans == "a"})
    elif t == "error": print("\nerror:", e["text"], file=sys.stderr); code = 1
    elif t == "done": break
print(); p.stdin.close(); p.wait(); sys.exit(code)
