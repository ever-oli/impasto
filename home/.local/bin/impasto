#!/bin/bash
# impasto — the lean niri fork's command line. Every verb is an IPC call into
# the running shell (`qs ipc call <target> <function> <args>`).
#
#   impasto open|toggle <panel>   launcher controls session keys t3 wifi
#                                 bluetooth sound microphone clipboard emoji
#   impasto close
#   impasto ask "<question>" [screen|region]  the notch assistant
#   impasto ask capture | mode <id>         grab the Helium tab · pick a mode
#   impasto picker [theme|wallpaper]       the carousel in the notch
#   impasto palette [Folder/Sub]           the palette, opened at a folder
#   impasto capture [region|window|screen] | text | record
#   impasto volume <0-100> | mute [on|off|toggle]
#   impasto focus [on|off|toggle]            do not disturb
#   impasto t3 [get|refresh|update|open]
#   impasto theme set <name> | get           (impasto-theme does the work)
#   impasto say <text> [icon]                a line on the island
#   impasto reload
#   impasto doctor                         check binds, shell, dependencies
set -euo pipefail

call() { qs ipc call "$@"; }

verb=${1:-help}; shift || true
case $verb in
    open|toggle)  call panel "$verb" "${1:?which panel}" ;;
    close)        call panel close ;;
    palette)      call palette open "${1:-}" ;;
    picker)       call picker open "${1:-theme}" ;;
    ask)          case "${1:-}" in
                      capture) call ask capture ;;
                      mode)    call ask mode "${2:?mode id}" ;;
                      *)       call ask ask "${1:?question}" "${2:-none}" ;;
                  esac ;;
    panels)       call panel list ;;
    capture)
        case ${1:-} in
            text)   call capture text ;;
            record) call capture record ;;
            *)      call capture open "${1:-}" ;;
        esac ;;
    record)       call capture record ;;
    volume)
        case ${1:-get} in
            mute) call volume mute "${2:-toggle}" ;;
            get)  call volume get ;;
            *)    call volume set "$1" ;;
        esac ;;
    focus)        call focus set "${1:-toggle}" ;;
    t3)           call t3 "${1:-get}" ;;
    theme)
        case ${1:-get} in
            set) exec "$HOME/.local/bin/impasto-theme" set "${2:?which theme}" ;;
            *)   exec "$HOME/.local/bin/impasto-theme" "$@" ;;
        esac ;;
    say)          call osd say "${1:?say what}" "${2:-}" ;;
    reload)       call shell reload ;;
    doctor)       exec "$HOME/.local/bin/impasto-doctor" ;;
    *)            sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
