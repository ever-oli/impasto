#!/bin/bash
# notch-dev — the tools Notch's Build mode uses to change itself. Every call is
# a shell command, so the notch's approval gate shows it to Ever first.
#   notch-dev status                  both repos: branch, dirty files
#   notch-dev test                    notch doctor + notch-theme audit + tests/*.sh
#   notch-dev deploy                  ./setup files (backs up first) + notch-theme restore
#   notch-dev restart-qs              stop the exact qs PID, respawn through niri
#   notch-dev branch <name>           new evolve/<name> branch in ~/src/notch
#   notch-dev pr "<title>" [body]     test, commit, push the branch, open a PR
#   notch-dev ship "<title>"          like pr, then merge to lean-niri (only if auto-merge is on)
#   notch-dev sync-dots               copy live VM config into ~/src/dotfiles on a branch + PR
#   notch-dev lesson "<text>"         append a correction to ~/.config/notch/lessons.md
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
REPO=${NOTCH_REPO:-$HOME/src/notch}; DOTS=${NOTCH_DOTS:-$HOME/src/dotfiles}
CONF=${XDG_CONFIG_HOME:-$HOME/.config}/notch
ensure() {
    [ -d "$REPO/.git" ] || gh repo clone ever-oli/notch "$REPO" -- -b lean-niri
    [ -d "$DOTS/.git" ] || gh repo clone ever-oli/dotfiles "$DOTS" -- -b notch-desktop
}
tests() {
    local bad=0
    notch-doctor || bad=1
    notch-theme audit || bad=1
    for t in "$REPO"/tests/*.sh; do bash "$t" || { echo "✗ $t"; bad=1; }; done
    return $bad
}
commit_pr() { # repo base title body
    local r=$1 base=$2 title=$3 body=${4:-"Made by Notch Build mode."}
    cd "$r"
    [ "$(git branch --show-current)" = "$base" ] && git switch -c "evolve/$(date +%Y%m%d-%H%M%S)"
    git add -A; git commit -qm "$title"
    git fetch -q origin "$base" && git rebase -q "origin/$base"
    git push -qu origin HEAD
    gh pr create --base "$base" --title "$title" --body "$body" 2>/dev/null || gh pr view --json url -q .url
}
verb=${1:-help}; shift || true
case $verb in
    status)  ensure; for r in "$REPO" "$DOTS"; do echo "== $r ($(git -C "$r" branch --show-current))"; git -C "$r" status -s; done ;;
    test)    ensure; tests ;;
    deploy)  ensure; cd "$REPO" && ./setup files && notch-theme restore ;;
    restart-qs)
        pid=$(pgrep -u "$(id -u)" -x qs || pgrep -u "$(id -u)" -x quickshell || true)
        sock=$(ls /run/user/"$(id -u)"/niri*.sock 2>/dev/null | head -1)
        [ -n "$sock" ] || { echo "no niri socket"; exit 1; }
        [ -n "$pid" ] && { [ "$(wc -w <<<"$pid")" = 1 ] || { echo "several qs: $pid"; exit 1; }; kill "$pid"; while kill -0 "$pid" 2>/dev/null; do sleep .2; done; }
        NIRI_SOCKET=$sock niri msg action spawn -- qs -n ;;
    branch)  ensure; git -C "$REPO" fetch -q origin lean-niri; git -C "$REPO" switch -c "evolve/${1:?name}" origin/lean-niri ;;
    pr)      ensure; tests || { echo "tests fail: no PR"; exit 1; }; commit_pr "$REPO" lean-niri "${1:?title}" "${2:-}" ;;
    ship)    ensure; [ "$(cat "$CONF/auto-merge" 2>/dev/null)" = on ] || { echo "auto-merge is off (echo on > $CONF/auto-merge)"; exit 1; }
             tests || { echo "tests fail: not shipping"; exit 1; }
             commit_pr "$REPO" lean-niri "${1:?title}"; cd "$REPO"; gh pr merge --squash --delete-branch; git switch -q lean-niri; git pull -q ;;
    sync-dots) ensure; cd "$DOTS"; git switch -q notch-desktop; git pull -q
             chezmoi --source "$DOTS" re-add 2>/dev/null || echo "(chezmoi re-add unavailable; copy by hand)"
             git diff --quiet && { echo "dotfiles already match the VM"; exit 0; }
             commit_pr "$DOTS" notch-desktop "sync: live VM config $(date +%F)" ;;
    lesson)  mkdir -p "$CONF"; printf -- '- %s (%s)\n' "${1:?text}" "$(date +%F)" >> "$CONF/lessons.md"; echo saved ;;
    *)       sed -n '2,13p' "$0" ;;
esac
