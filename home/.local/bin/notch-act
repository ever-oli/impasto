#!/bin/sh
# notch-act — the notch assistant's hands on the desktop.
#   notch-act look [file]          screenshot of the screen (default /tmp/notch-look.png)
#   notch-act type <text>          type text into the focused window
#   notch-act key <keys…>          press keys, e.g. key ctrl+l   key Return
#   notch-act click <x> <y> [left|right|middle]   click at screen pixels
#   notch-act move <x> <y>         move the pointer to screen pixels
#   notch-act scroll <dy>          scroll (positive is down)
#   notch-act window [list|focus <id>]   niri windows
#   notch-act open <app|url>       launch an app or open a URL
set -e
to() { wlrctl pointer move -100000 -100000; wlrctl pointer move "$1" "$2"; }
case "$1" in
    look)   f=${2:-/tmp/notch-look.png}; grim -o Virtual-1 "$f"; echo "$f" ;;
    type)   shift; wtype -- "$*" ;;
    key)    shift; for k in "$@"; do
                set -- $(echo "$k" | tr '+' ' '); args=""
                while [ $# -gt 1 ]; do args="$args -M $1"; shift; done
                rel=$(echo "$args" | sed 's/-M/-m/g'); wtype $args -k "$1" $rel
            done ;;
    click)  to "$2" "$3"; wlrctl pointer click "${4:-left}" ;;
    move)   to "$2" "$3" ;;
    scroll) wlrctl pointer scroll "$2" 0 ;;
    window) if [ "$2" = focus ]; then niri msg action focus-window --id "$3"; else niri msg windows; fi ;;
    open)   shift; case "$1" in *://*) xdg-open "$1" ;; *) setsid -f "$@" >/dev/null 2>&1 ;; esac ;;
    *)      sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
