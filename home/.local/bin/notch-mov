#!/usr/bin/env python3
"""notch-mov — mov-cli, the notch's copy of it, in the island terminal.

mov-cli is unmaintained upstream, so the notch keeps its own: the source
is vendored under ~/.local/share/notch/mov-cli, the YouTube plugin is
vendored next to it with the rot fixed (yt-dlp stopped sending the
fields the plugin read), and both are installed into a venv on mise's
Python 3.12 — the newest the code supports.

  notch-mov                 open the terminal and browse with mov-cli
  notch-mov <title>         the same, with a title to start from
  notch-mov install         make the venv (and its plugins) from scratch
  notch-mov run <args…>     run mov-cli here, not in the terminal
"""

import json
import os
import subprocess
import sys
import time
from pathlib import Path

HOME = os.environ.get("HOME", os.path.expanduser("~"))
ROOT = Path(HOME) / ".local/share/notch/mov-cli"
VENV = ROOT / ".venv"
SESSION = "notch"


def mise_python():
    """Mise's python 3.12, the newest mov-cli supports."""
    best = None
    for path in sorted((Path(HOME) / ".local/share/mise/installs/python").glob("3.12*/bin/python3.12")):
        best = path
    return best


def venv_python():
    return VENV / "bin/python"


def installed():
    return (venv_python()).exists()


def install():
    """Build the venv: the vendored mov-cli, the patched plugin, yt-dlp."""
    if installed():
        return
    python = mise_python()
    if not python:
        sys.exit("notch-mov: no python 3.12 (mise install python@3.12)")
    VENV.parent.mkdir(parents=True, exist_ok=True)
    subprocess.run([str(python), "-m", "venv", str(VENV)], check=True)
    pip = str(venv_python().parent / "pip")
    subprocess.run([pip, "install", "-q", "--upgrade", "pip"], check=False)
    subprocess.run([pip, "install", "-q", str(ROOT)], check=True)
    # The plugin is vendored and patched, so it goes in over the published one.
    subprocess.run([pip, "install", "-q", "--force-reinstall", "--no-deps",
                    str(ROOT / "plugins")], check=False)
    subprocess.run([pip, "install", "-q", "yt-dlp", "pytube"], check=False)
    print("notch-mov: the venv is ready")


def terminal_open():
    """Is the island terminal up?"""
    try:
        out = subprocess.run(["notch-term", "status"], capture_output=True,
                             timeout=10).stdout
        return bool(json.loads(out or "{}").get("open"))
    except Exception:
        return False


def in_terminal(command):
    """Run a command in the island terminal."""
    if not terminal_open():
        subprocess.run(["notch-term", "toggle"], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL)
        time.sleep(2.0)
    subprocess.run(["tmux", "send-keys", "-t", SESSION, command, "Enter"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    args = sys.argv[1:]
    if args and args[0] == "install":
        install()
        return
    if args and args[0] == "run":
        if not installed():
            install()
        os.execv(str(venv_python().parent / "mov-cli"),
                 ["mov-cli"] + args[1:])
    if not installed():
        install()
    title = " ".join(args)
    in_terminal(f"mov-cli {title}" if title else "mov-cli")


if __name__ == "__main__":
    main()
