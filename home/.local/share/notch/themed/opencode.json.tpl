{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "primary": "{{ accent }}",
    "secondary": "{{ magenta }}",
    "accent2": "{{ cyan }}",
    "error": "{{ mix red foreground 20% }}",
    "warning": "{{ yellow }}",
    "success": "{{ mix green foreground 20% }}",
    "info": "{{ orange }}",
    "fg": "{{ foreground }}",
    "fgMuted": "{{ muted }}",
    "bg": "{{ background }}",
    "bgPanel": "{{ darker_background }}",
    "bgElement": "{{ mix darker_background foreground 5% }}",
    "border": "{{ muted }}",
    "borderActive": "{{ mix muted foreground 40% }}",
    "bgAdded": "{{ mix darker_background green 25% }}",
    "bgRemoved": "{{ mix darker_background red 25% }}",
    "lineNo": "{{ mix darker_background foreground 35% }}",
    "selectedBg": "{{ selection }}",
    "selectedFg": "{{ selection_foreground }}"
  },
  "theme": {
    "primary": "primary",
    "secondary": "secondary",
    "accent": "accent2",
    "error": "error",
    "warning": "warning",
    "success": "success",
    "info": "info",
    "text": "fg",
    "textMuted": "fgMuted",
    "selectedBackground": "selectedBg",
    "selectedListItemText": "selectedFg",
    "background": "bg",
    "backgroundPanel": "bgPanel",
    "backgroundElement": "bgElement",
    "border": "border",
    "borderActive": "borderActive",
    "borderSubtle": "bgElement",
    "diffAdded": "success",
    "diffRemoved": "error",
    "diffContext": "fgMuted",
    "diffHunkHeader": "fgMuted",
    "diffHighlightAdded": "success",
    "diffHighlightRemoved": "error",
    "diffAddedBg": "bgAdded",
    "diffRemovedBg": "bgRemoved",
    "diffContextBg": "bgPanel",
    "diffLineNumber": "lineNo",
    "diffAddedLineNumberBg": "bgAdded",
    "diffRemovedLineNumberBg": "bgRemoved",
    "markdownText": "fg",
    "markdownHeading": "primary",
    "markdownLink": "accent2",
    "markdownLinkText": "secondary",
    "markdownCode": "info",
    "markdownBlockQuote": "fgMuted",
    "markdownEmph": "warning",
    "markdownStrong": "primary",
    "markdownHorizontalRule": "fgMuted",
    "markdownListItem": "secondary",
    "markdownListEnumeration": "warning",
    "markdownImage": "accent2",
    "markdownImageText": "secondary",
    "markdownCodeBlock": "fg",
    "syntaxComment": "fgMuted",
    "syntaxKeyword": "secondary",
    "syntaxFunction": "primary",
    "syntaxVariable": "fg",
    "syntaxString": "success",
    "syntaxNumber": "info",
    "syntaxType": "accent2",
    "syntaxOperator": "secondary",
    "syntaxPunctuation": "fgMuted"
  }
}
