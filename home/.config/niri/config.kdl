// ==== input.kdl ====
// Input devices: keyboards, mice, touchpads
input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    focus-follows-mouse
}

// ==== monitors.kdl ====
// Monitors: outputs, resolution, placement
output "Virtual-1" {
    mode "1920x1080@60.000"
    scale 1
    position x=0 y=0
}

// ==== looknfeel.kdl ====
// Look & feel: layout geometry, animations, misc UI
layout {
    gaps 10
    center-focused-column "never"
    default-column-width {
        proportion 0.5
    }
    // Rhythm for Super+R: third, half, two-thirds, full.
    preset-column-widths {
        proportion 0.3333
        proportion 0.5
        proportion 0.6667
        proportion 1.0
    }
    focus-ring {
        width 2
    }
    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=6
    }
    border {
        off
    }
}
prefer-no-csd
animations {
    // Remote-link tuned: critically damped, stiff springs, ultra-short eases —
    // motion without latency stacking. (damping-ratio > 1 discouraged upstream.)
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1800 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=1800 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=1800 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=1800 epsilon=0.0001
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=1800 epsilon=0.0001
    }
    window-open {
        duration-ms 80
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 60
        curve "ease-out-quad"
    }
    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1000 epsilon=0.001
    }
}
hotkey-overlay {
    skip-at-startup
}
// Rounded window corners: windows get 14px radii, and the focus ring /
// shadows follow the rounded geometry.
window-rule {
    geometry-corner-radius 14
    clip-to-geometry true
}

screenshot-path "~/Pictures/Screenshots/%Y-%m-%d_%H-%M-%S.png"

// ==== autostart.kdl ====
// The notch shell (bar, launcher, notifications, OSD, polkit agent) and the
// theme's wallpaper. Spawned here rather than as a user service so the shell
// is in the logind session, which the polkit agent needs. No mako: the shell
// is the notification server.
spawn-at-startup "notch-theme" "restore"
spawn-at-startup "qs" "-n"

// ==== bindings.kdl ====
// Alt is the main key: Cmd/Super is eaten by iPadOS (Spotlight, app switcher)
// before RustDesk sees it, Option/Alt always gets through. The Super binds
// stay for a real keyboard.
//
// One bind per line: ~/.local/bin/niri-virtual-binds re-fires binds for the
// RustDesk virtual keyboard by parsing this file line by line.
binds {
    // ── shell (notch) ──
    Alt+Space { spawn "notch" "toggle" "launcher"; }
    Mod+Space { spawn "notch" "toggle" "launcher"; }
    Ctrl+Alt+Space { spawn "notch" "toggle" "launcher"; }
    Alt+A { spawn "notch" "toggle" "ask"; }
    Mod+A { spawn "notch" "toggle" "ask"; }
    Alt+Y { spawn "notch" "ask" "capture"; }
    Mod+Y { spawn "notch" "ask" "capture"; }
    Mod+Ctrl+Space { spawn "notch" "toggle" "launcher"; }
    Ctrl+Alt+T { spawn "notch" "picker" "theme"; }
    Ctrl+Alt+B { spawn "notch" "picker" "wallpaper"; }
    Ctrl+Alt+V { spawn "notch" "toggle" "clipboard"; }
    Alt+W hotkey-overlay-title="Switch window" { spawn "notch" "toggle" "windows"; }
    Alt+Slash hotkey-overlay-title="Find a file" { spawn "notch" "toggle" "files"; }
    Ctrl+Alt+E { spawn "notch" "toggle" "emoji"; }
    Ctrl+Alt+S { spawn "notch" "capture" "region"; }
    Ctrl+Alt+A { spawn "notch" "capture"; }
    Ctrl+Alt+R { spawn "notch" "record"; }
    Ctrl+Alt+K { spawn "notch" "toggle" "keys"; }
    Ctrl+Alt+C { spawn "notch" "toggle" "controls"; }
    Ctrl+Alt+3 { spawn "notch" "toggle" "t3"; }
    Ctrl+Alt+N { spawn "notch" "focus" "toggle"; }
    Ctrl+Alt+Escape { spawn "notch" "toggle" "session"; }
    Ctrl+Alt+Q { spawn "notch" "toggle" "session"; }
    Mod+Ctrl+T { spawn "notch" "picker" "theme"; }
    Mod+Ctrl+B { spawn "notch" "picker" "wallpaper"; }
    Mod+Ctrl+V { spawn "notch" "toggle" "clipboard"; }
    Mod+Ctrl+E { spawn "notch" "toggle" "emoji"; }
    Mod+Ctrl+S { spawn "notch" "capture" "region"; }
    Mod+Ctrl+A { spawn "notch" "capture"; }
    Mod+Ctrl+R { spawn "notch" "record"; }
    Mod+Ctrl+K { spawn "notch" "toggle" "keys"; }
    Mod+Ctrl+C { spawn "notch" "toggle" "controls"; }
    Mod+Ctrl+3 { spawn "notch" "toggle" "t3"; }
    Mod+Ctrl+N { spawn "notch" "focus" "toggle"; }
    Mod+Ctrl+Escape { spawn "notch" "toggle" "session"; }
    Mod+Ctrl+Q { spawn "notch" "toggle" "session"; }

    // ── apps ──
    Alt+Return { spawn "ghostty"; }
    Mod+Return { spawn "ghostty"; }
    Alt+Shift+Return { spawn "helium-browser"; }
    Mod+Shift+Return { spawn "helium-browser"; }

    // ── windows ──
    Alt+Q { close-window; }
    Mod+Q { close-window; }
    Mod+W { close-window; }
    Alt+F { maximize-column; }
    Mod+F { maximize-column; }
    Alt+Shift+F { fullscreen-window; }
    Mod+Shift+F { fullscreen-window; }
    Alt+Left { focus-column-left; }
    Alt+Right { focus-column-right; }
    Alt+Up { focus-window-up; }
    Alt+Down { focus-window-down; }
    Alt+H { focus-column-left; }
    Alt+L { focus-column-right; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    // Desktops, as the bell wants: Super+Up/Down across workspaces. Window
    // focus keeps H/L; Alt+Shift+Up/Down still carries a window between them.
    Mod+Up { focus-workspace-up; }
    Mod+Down { focus-workspace-down; }
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Alt+Shift+Left { move-column-left; }
    Alt+Shift+Right { move-column-right; }
    Alt+Shift+Up { move-window-up-or-to-workspace-up; }
    Alt+Shift+Down { move-window-down-or-to-workspace-down; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up { move-window-up-or-to-workspace-up; }
    Mod+Shift+Down { move-window-down-or-to-workspace-down; }
    Alt+Comma { consume-window-into-column; }
    Alt+Period { expel-window-from-column; }
    Mod+Comma { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Alt+Minus { set-column-width "-10%"; }
    Alt+Equal { set-column-width "+10%"; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // ── workspaces ──
    Alt+Tab { toggle-overview; }
    Alt+O { toggle-overview; }
    Mod+D { toggle-overview; }
    Mod+O { toggle-overview; }
    Mod+Alt+O hotkey-overlay-title="Orb" { spawn "qs" "ipc" "call" "orb" "toggle"; }
    Alt+1 { focus-workspace 1; }
    Alt+2 { focus-workspace 2; }
    Alt+3 { focus-workspace 3; }
    Alt+4 { focus-workspace 4; }
    Alt+5 { focus-workspace 5; }
    Alt+Shift+1 { move-column-to-workspace 1; }
    Alt+Shift+2 { move-column-to-workspace 2; }
    Alt+Shift+3 { move-column-to-workspace 3; }
    Alt+Shift+4 { move-column-to-workspace 4; }
    Alt+Shift+5 { move-column-to-workspace 5; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Alt+Page_Up { focus-workspace-up; }
    Alt+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Alt+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Alt+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }

    // ── niri ──
    Mod+K { show-hotkey-overlay; }
    Print { screenshot; }
    Alt+Shift+E { quit; }
    Mod+Shift+E { quit; }
    Ctrl+Shift+Z repeat=false { spawn "gdbus" "call" "--session" "--dest" "com.t3tools.T3Code.SnapShot" "--object-path" "/com/t3tools/SnapShot" "--method" "com.t3tools.SnapShot.Capture"; }
}

// ==== windows.kdl ====
// Window rules
// ASCII Theater: open as an immersive full-screen cinematic session
window-rule {
    match app-id="ascii-theater"
    open-fullscreen true
}

// ==== workspaces.kdl ====
// Workspace defaults: none configured yet — see niri wiki "workspace"

// ==== envs.kdl ====
// Session environment
environment {
    PATH "/home/ever/.local/bin:/home/ever/.local/share/mise/shims:/usr/local/sbin:/usr/local/bin:/usr/bin"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    EDITOR "helix"
}

// ==== theme ====
// Focus ring and border colours, written by `notch-theme set <name>`.
// Last, so it overrides the layout block above.
include "notch-theme.kdl"
