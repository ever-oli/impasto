#!/bin/bash
# notch — the notch shell's command line. Every verb is an IPC call into
# the running shell (`qs ipc call <target> <function> <args>`).
#
#   notch open|toggle <panel>   launcher controls session keys t3 wifi
#                                 bluetooth sound microphone clipboard emoji
#                                 anime notchstorm
#   notch close
#   notch context get|hand             what the notch knows, or hand it over
#   notch work [get|platforms|hand n]  the work: postings and platforms
#   notch install [--dry-run]              bootstrap a fresh Arch machine (INSTALL.md)
#   notch picker [theme|wallpaper]       the carousel in the notch
#   notch palette [Folder/Sub]           the palette, opened at a folder
#   notch capture [region|window|screen] | text | record
#   notch volume <0-100> | mute [on|off|toggle]
#   notch focus [on|off|toggle]            do not disturb
#   notch t3 [get|refresh|update|open]
#   notch theme set <name> | get           (notch-theme does the work)
#   notch say <text> [icon]                a line on the island
#   notch learn "<lesson>"                 a correction that sticks forever (lessons.md)
#   notch reload
#   notch doctor                         check binds, shell, dependencies
set -euo pipefail

# `qs ipc call` always exits 0, even when the target answers with an
# error. The cli is what a script or a bind runs, so it has to fail when
# the shell said no.
call() {
    answer=$(qs ipc call "$@")
    echo "$answer"
    case "$answer" in
        *'"error"'*) return 1 ;;
        *) return 0 ;;
    esac
}

verb=${1:-help}; shift || true
case $verb in
    open|toggle)  call panel "$verb" "${1:?which panel}" ;;
    close)        call panel close ;;
    palette)      call palette open "${1:-/}" ;;   # a folder in the menu tree
    picker)       call picker open "${1:-theme}" ;;
    context)
        case "${1:-get}" in
            hand) call context hand ;;
            *)    call context get ;;
        esac ;;
    work)
        case "${1:-get}" in
            platforms) call work platforms ;;
            platform)  call work platform "${2:?which platform}" ;;
            hand)      call work hand "${2:-job}" "${3:?which one}" ;;
            *)         call work get ;;
        esac ;;
    install)      exec "${NOTCH_SRC:-$HOME/.local/src/notch}/install" "$@" ;;
    panels)       call panel list ;;
    capture)
        case ${1:-} in
            text)   call capture text ;;
            record) call capture record ;;
            *)      call capture open "${1:-}" ;;
        esac ;;
    record)       call capture record ;;
    volume)
        case ${1:-get} in
            mute) call volume mute "${2:-toggle}" ;;
            get)  call volume get ;;
            *)    call volume set "$1" ;;
        esac ;;
    focus)        call focus set "${1:-toggle}" ;;
    t3)           call t3 "${1:-get}" ;;
    theme)
        case ${1:-get} in
            set) exec "$HOME/.local/bin/notch-theme" set "${2:?which theme}" ;;
            *)   exec "$HOME/.local/bin/notch-theme" "$@" ;;
        esac ;;
    say)          call osd say "${1:?say what}" "${2:-}" ;;
    learn)
        lesson="${*:-$([[ -t 0 ]] && printf '' || cat)}"
        python3 - "$lesson" <<'PY'
import re, sys, time, os
lesson = sys.argv[1].strip().replace("\x00", "") if len(sys.argv) > 1 else ""
if not lesson:
    sys.exit("notch learn: teach with text: notch learn \"<what to remember>\"")
path = f"{os.path.expanduser('~')}/.config/notch/lessons.md"
os.makedirs(os.path.dirname(path), exist_ok=True)
body = open(path).read() if os.path.exists(path) else ""
flat = re.sub(r"\s+", " ", lesson)
if flat[:80] and flat[:80] in re.sub(r"\s+", " ", body):
    print("already learned"); sys.exit()
stamp = time.strftime("%Y-%m-%d")
entry = f"\n# {stamp} — {flat[:80]}\n{lesson}\n"
body = body + entry
# The prompt tail keeps the newest 6k; the file holds the newest 24k.
if len(body) > 24000:
    body = "\n".join(body.splitlines()[-120:])
open(path, "w").write(body)
print("learned — it rides every act-mode prompt from now on")
PY
        ;;
    reload)       call shell reload ;;
    doctor)       exec "$HOME/.local/bin/notch-doctor" ;;
    help|--help|-h) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)            sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
