#!/bin/bash
# notch-webapp <url> — open a site as its own Helium app window (no tabs, no
# toolbar), sharing the main Helium profile so logins carry over.
case "${1:-}" in
    --help|-h|"") sed -n '2,4p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac
exec helium-browser --app="${1:?usage: notch-webapp <url>}" "${@:2}"
